<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vista del asistente de aprobación -->
        <record id="view_hr_extra_hours_approval_wizard_form" model="ir.ui.view">
            <field name="name">hr.extra.hours.approval.wizard.form</field>
            <field name="model">hr.extra.hours.approval.wizard</field>
            <field name="arch" type="xml">
                <form string="Aprobar/Rechazar Solicitud">
                    <group>
                        <field name="request_id" readonly="1"/>
                        <field name="action" widget="radio"/>
                    </group>
                    <group invisible="action != 'approve'">
                        <field name="payable_hours"/>
                    </group>
                    <group invisible="action != 'reject'">
                        <field name="rejection_reason" required="1"/>
                    </group>
                    <group>
                        <field name="comment"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Vista del asistente de rechazo -->
        <record id="view_hr_extra_hours_rejection_wizard_form" model="ir.ui.view">
            <field name="name">hr.extra.hours.rejection.wizard.form</field>
            <field name="model">hr.extra.hours.rejection.wizard</field>
            <field name="arch" type="xml">
                <form string="Rechazar Solicitud">
                    <group>
                        <field name="request_id" readonly="1"/>
                        <field name="rejection_reason" required="1"/>
                        <field name="comment"/>
                    </group>
                    <footer>
                        <button name="action_reject" string="Rechazar" type="object" class="btn-danger"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acciones para los wizards -->
        <record id="action_hr_extra_hours_approval_wizard" model="ir.actions.act_window">
            <field name="name">Aprobar/Rechazar Solicitud</field>
            <field name="res_model">hr.extra.hours.approval.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="action_hr_extra_hours_rejection_wizard" model="ir.actions.act_window">
            <field name="name">Rechazar Solicitud</field>
            <field name="res_model">hr.extra.hours.rejection.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
