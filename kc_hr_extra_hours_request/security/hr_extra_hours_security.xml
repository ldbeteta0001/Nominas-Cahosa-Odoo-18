<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Categoría de módulo para Horas Extra -->
        <record id="hr_extra_hours_category" model="ir.module.category">
            <field name="name">Horas Extra</field>
            <field name="description">Permisos para gestión de horas extra</field>
            <field name="sequence">10</field>
        </record>
        
        <!-- Definición de grupos de seguridad -->
        <record id="group_hr_extra_hours_manager" model="res.groups">
            <field name="name">Gestor de Horas Extra</field>
            <field name="category_id" ref="hr_extra_hours_category"/>
            <field name="comment">Puede aprobar y rechazar solicitudes de horas extra de sus subordinados</field>
        </record>

        <record id="group_hr_extra_hours_employee" model="res.groups">
            <field name="name">Empleado de Horas Extra</field>
            <field name="category_id" ref="hr_extra_hours_category"/>
            <field name="comment">Puede crear y ver sus propias solicitudes de horas extra</field>
        </record>

        <!-- Reglas de registro para solicitudes de horas extra -->
        <record id="hr_extra_hours_request_employee_rule" model="ir.rule">
            <field name="name">Empleado: Solo sus solicitudes</field>
            <field name="model_id" ref="model_hr_extra_hours_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_extra_hours_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_extra_hours_request_manager_rule" model="ir.rule">
            <field name="name">Jefe: Solicitudes de subordinados</field>
            <field name="model_id" ref="model_hr_extra_hours_request"/>
            <field name="domain_force">['|', ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_extra_hours_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_extra_hours_request_hr_rule" model="ir.rule">
            <field name="name">RRHH: Todas las solicitudes</field>
            <field name="model_id" ref="model_hr_extra_hours_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_extra_hours_request_portal_rule" model="ir.rule">
            <field name="name">Portal: Solo sus solicitudes</field>
            <field name="model_id" ref="model_hr_extra_hours_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Reglas de registro para motivos de horas extra -->
        <record id="hr_extra_hours_reason_employee_rule" model="ir.rule">
            <field name="name">Empleado: Solo lectura de motivos</field>
            <field name="model_id" ref="model_hr_extra_hours_reason"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_hr_extra_hours_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_extra_hours_reason_manager_rule" model="ir.rule">
            <field name="name">Jefe: Lectura de motivos</field>
            <field name="model_id" ref="model_hr_extra_hours_reason"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_extra_hours_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_extra_hours_reason_hr_rule" model="ir.rule">
            <field name="name">RRHH: Todos los motivos</field>
            <field name="model_id" ref="model_hr_extra_hours_reason"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_extra_hours_reason_portal_rule" model="ir.rule">
            <field name="name">Portal: Solo lectura de motivos activos</field>
            <field name="model_id" ref="model_hr_extra_hours_reason"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Reglas de acceso para solicitudes de horas extra -->
        <record id="access_hr_extra_hours_request_employee" model="ir.model.access">
            <field name="name">hr.extra.hours.request.employee</field>
            <field name="model_id" ref="model_hr_extra_hours_request"/>
            <field name="group_id" ref="hr.group_hr_user"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="access_hr_extra_hours_request_manager" model="ir.model.access">
            <field name="name">hr.extra.hours.request.manager</field>
            <field name="model_id" ref="model_hr_extra_hours_request"/>
            <field name="group_id" ref="group_hr_extra_hours_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="access_hr_extra_hours_request_hr" model="ir.model.access">
            <field name="name">hr.extra.hours.request.hr</field>
            <field name="model_id" ref="model_hr_extra_hours_request"/>
            <field name="group_id" ref="hr.group_hr_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Reglas de acceso para motivos de horas extra -->
        <record id="access_hr_extra_hours_reason_employee" model="ir.model.access">
            <field name="name">hr.extra.hours.reason.employee</field>
            <field name="model_id" ref="model_hr_extra_hours_reason"/>
            <field name="group_id" ref="hr.group_hr_user"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="access_hr_extra_hours_reason_manager" model="ir.model.access">
            <field name="name">hr.extra.hours.reason.manager</field>
            <field name="model_id" ref="model_hr_extra_hours_reason"/>
            <field name="group_id" ref="group_hr_extra_hours_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="access_hr_extra_hours_reason_hr" model="ir.model.access">
            <field name="name">hr.extra.hours.reason.hr</field>
            <field name="model_id" ref="model_hr_extra_hours_reason"/>
            <field name="group_id" ref="hr.group_hr_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
