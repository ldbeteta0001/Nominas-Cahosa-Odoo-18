<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista para configuración de horas extra -->
    <record id="view_config_overtime_hours_tree" model="ir.ui.view">
        <field name="name">config.overtime.hours.tree</field>
        <field name="model">config.overtime.hours</field>
        <field name="arch" type="xml">
            <list string="Configuración de Horas Extra">
                <field name="name"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'draft'"/>
                <field name="hour_25_from"/>
                <field name="hour_25_to"/>
                <field name="hour_50_from"/>
                <field name="hour_50_to"/>
                <field name="hour_75_from"/>
                <field name="hour_75_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para configuración de horas extra -->
    <record id="view_config_overtime_hours_form" model="ir.ui.view">
        <field name="name">config.overtime.hours.form</field>
        <field name="model">config.overtime.hours</field>
        <field name="arch" type="xml">
            <form string="Configuración de Rangos de Horas Extra">
                <header>
                    <button name="action_activate" string="Activar" type="object" 
                            class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_draft" string="Pasar a Borrador" type="object" 
                            invisible="state == 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rango 25%" name="range_25">
                            <group>
                                <group string="Horas Extra al 25%">
                                    <field name="hour_25_from" 
                                           widget="float" 
                                           options="{'precision': 2}"
                                           help="Hora de inicio del rango (formato: 18.5 = 18:30)"/>
                                    <field name="hour_25_to" 
                                           widget="float" 
                                           options="{'precision': 2}"
                                           help="Hora de fin del rango (formato: 20.5 = 20:30)"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rango 50%" name="range_50">
                            <group>
                                <group string="Horas Extra al 50%">
                                    <field name="hour_50_from" 
                                           widget="float" 
                                           options="{'precision': 2}"
                                           help="Hora de inicio del rango (formato: 20.5 = 20:30)"/>
                                    <field name="hour_50_to" 
                                           widget="float" 
                                           options="{'precision': 2}"
                                           help="Hora de fin del rango (formato: 22.5 = 22:30)"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rango 75%" name="range_75">
                            <group>
                                <group string="Horas Extra al 75%">
                                    <field name="hour_75_from" 
                                           widget="float" 
                                           options="{'precision': 2}"
                                           help="Hora de inicio del rango (formato: 22.5 = 22:30)"/>
                                    <field name="hour_75_to" 
                                           widget="float" 
                                           options="{'precision': 2}"
                                           help="Hora de fin del rango (formato: 6.0 = 06:00 del día siguiente)"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana para configuración de horas extra -->
    <record id="action_config_overtime_hours" model="ir.actions.act_window">
        <field name="name">Configuración de Horas Extra</field>
        <field name="res_model">config.overtime.hours</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una configuración de rangos de horas extra
            </p>
            <p>
                Configura los rangos horarios para calcular las horas extra al 25%, 50% y 75%.
                Las horas deben estar en formato decimal (ej: 18.5 = 18:30).
            </p>
        </field>
    </record>

    <!-- Menú para configuración de horas extra -->
    <menuitem id="menu_config_overtime_hours"
              name="Configuración Horas Extra"
              parent="hr.menu_human_resources_configuration"
              action="action_config_overtime_hours"
              sequence="100"
              groups="hr.group_hr_manager"/>
</odoo>

