<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Vista heredada de hr.contract para agregar campos de turnos -->
    <record id="view_hr_contract_form_inherit_shift" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.shift</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar campos de turno después de structure_type_id -->
            <xpath expr="//field[@name='structure_type_id']" position="after">
                <field name="es_mecanico"
                       string="Es Mecánico"
                       help="Marcar si el empleado es mecánico. Los sábados se calcularán al 50% en lugar de 25%."/>
                <field name="aplica_horas_extras"
                       string="Aplica Horas Extras"
                       help="Indica si el contrato aplica para el cálculo de horas extras."/>
                <field name="current_shift_period"
                       string="Turno Actual"
                       readonly="1"
                       widget="badge"
                       decoration-info="current_shift_period == 'dia'"
                       decoration-muted="current_shift_period == 'noche'"
                       help="Turno actual del empleado basado en el historial de turnos. Día (06:00-18:00) o Noche (18:00-06:00)"/>
                <button name="action_update_shift_period"
                        string="Actualizar Turno"
                        type="object"
                        class="btn-secondary"
                        icon="fa-refresh"
                        help="Actualiza el turno actual desde el historial de turnos programados"/>
            </xpath>

            <!-- Agregar pestaña de Historial de Turnos en el notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Historial de Turnos" name="shift_history_tab"
                      invisible="not employee_id">
                    <group>
                        <button name="action_create_shift_exception" 
                                string="Registrar Excepción" 
                                type="object"
                                class="btn-primary"
                                icon="fa-plus"
                                invisible="not employee_id"
                                help="Registrar una excepción de turno que ajustará automáticamente los períodos existentes"/>
                    </group>
                    <field name="shift_history_ids" nolabel="1">
                        <list delete="true" editable="bottom" create="true" edit="true">
                            <field name="shift_period"
                                   widget="badge"
                                   decoration-info="shift_period == 'dia'"
                                   decoration-muted="shift_period == 'noche'"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="is_current" widget="boolean_toggle"/>
                            <field name="changed_by"/>
                            <field name="reason" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>