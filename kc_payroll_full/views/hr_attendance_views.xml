<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extensión de la vista de formulario de asistencia para campos parciales y horario programado -->
        <!-- Esta vista se carga primero y agrega campos básicos después de check_in -->
        <record id="view_attendance_form_inherit_partial" model="ir.ui.view">
            <field name="name">hr.attendance.form.inherit.partial</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
            <field name="arch" type="xml">
                <!-- Agregar campos de horario programado y asistencia parcial después de check_in -->
                <xpath expr="//field[@name='check_in']" position="after">
                    <group string="Horario Programado" col="2" invisible="not check_in_schedule and not check_out_schedule">
                        <field name="check_in_schedule" 
                               string="Entrada según Horario" 
                               invisible="not check_in_schedule" 
                               readonly="1" 
                               widget="datetime"/>
                        <field name="check_out_schedule" 
                               string="Salida según Horario" 
                               invisible="not check_out_schedule" 
                               readonly="1" 
                               widget="datetime"/>
                    </group>
                    <group string="Asistencia Parcial" col="2" invisible="not is_partial">
                        <field name="is_partial" readonly="1"/>
                        <field name="partial_type" 
                               readonly="1" 
                               invisible="not is_partial"/>
                    </group>
                </xpath>
            </field>
        </record>
        
        <!-- Extensión de la vista de lista de asistencia para campos parciales -->
        <record id="view_attendance_tree_inherit_partial" model="ir.ui.view">
            <field name="name">hr.attendance.tree.inherit.partial</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">
                <!-- Agregar campos después de check_in -->
                <xpath expr="//field[@name='check_in']" position="after">
                    <field name="check_in_schedule" 
                           string="Entrada Horario" 
                           optional="hide" 
                           widget="datetime"/>
                    <field name="is_partial" optional="show"/>
                    <field name="partial_type" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
