<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista del wizard de importación -->
        <record id="view_shift_assignment_import_wizard_form" model="ir.ui.view">
            <field name="name">shift.assignment.import.wizard.form</field>
            <field name="model">shift.assignment.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Importar Asignaciones de Turnos desde Excel">
                    <group>
                        <group>
                            <field name="file" filename="filename" required="1"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="date" required="1"/>
                            <field name="has_date_column"/>
                        </group>
                    </group>
                    <group string="Instrucciones">
                        <div class="alert alert-info" role="alert">
                            <p><strong>Formato del archivo Excel:</strong></p>
                            <ul>
                                <li><strong>Columna A:</strong> Nombre del Empleado o ID Biométrico</li>
                                <li><strong>Columna B:</strong> Turno (dia/noche o Día/Noche)</li>
                                <li><strong>Columna C:</strong> Fecha (opcional, solo si marca "El Excel tiene columna de Fecha")</li>
                            </ul>
                            <p><strong>Nota:</strong> La primera fila debe ser los encabezados. Las filas vacías se ignorarán.</p>
                        </div>
                    </group>
                    <footer>
                        <button string="Importar" name="action_import" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción para el wizard de importación -->
        <record id="action_shift_assignment_import_wizard" model="ir.actions.act_window">
            <field name="name">Importar Asignaciones de Turnos</field>
            <field name="res_model">shift.assignment.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
