<odoo>
  <record id="view_hr_shift_assignment_import_form" model="ir.ui.view">
    <field name="name">hr.shift.assignment.import.form</field>
    <field name="model">hr.shift.assignment.import</field>
    <field name="arch" type="xml">
      <form string="Importar Turnos">
        <sheet>
          <group>
            <field name="file_data" filename="file_name" widget="binary"/>
            <field name="file_name"/>
            <field name="apply_date"/>
            <field name="rotation_id" invisible="1"/>
          </group>
          <group>
            <div class="o_form_label">Excel esperado: columnas 'Empleado' y 'Turno' (Día o Noche).</div>
          </group>
          <footer>
            <button string="Importar" type="object" name="action_import" class="btn-primary"/>
            <button string="Cancelar" class="btn-secondary" special="cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_hr_shift_assignment_import" model="ir.actions.act_window">
    <field name="name">Importar Turnos</field>
    <field name="res_model">hr.shift.assignment.import</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
