<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario del wizard -->
    <record id="view_hr_employee_biometric_import_form" model="ir.ui.view">
        <field name="name">hr.employee.biometric.import.form</field>
        <field name="model">hr.employee.biometric.import</field>
        <field name="arch" type="xml">
            <form string="Importar IDs Biométricos">
                <sheet>
                    <group>
                        <field name="file_data" filename="file_name" widget="binary"/>
                        <field name="file_name" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p><strong>Formato del archivo Excel:</strong></p>
                        <ul>
                            <li><strong>Columna A:</strong> ID Empleac (ID Biométrico - debe ser un número)</li>
                            <li><strong>Columna B:</strong> Nombre (Nombre completo del empleado)</li>
                        </ul>
                        <p>El sistema buscará el empleado por nombre. Si no existe, se creará automáticamente.</p>
                    </div>
                    <footer>
                        <button string="Importar" type="object" name="action_import" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para levantar el wizard -->
    <record id="action_hr_employee_biometric_import" model="ir.actions.act_window">
        <field name="name">Importar IDs Biométricos</field>
        <field name="res_model">hr.employee.biometric.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Opción de menú bajo Empleados -->
    <menuitem id="menu_hr_employee_biometric_import"
              name="Importar IDs Biométricos"
              parent="hr.menu_hr_root"
              action="action_hr_employee_biometric_import"
              sequence="100"/>
</odoo>

