<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_biometric_sync_server_data_wizard_form" model="ir.ui.view">
        <field name="name">biometric.sync.server.data.wizard.form</field>
        <field name="model">biometric.sync.server.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Sincronizar Datos del Servidor">
                <sheet>
                    <group>
                        <field name="device_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="sync_type"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_sync" string="Sincronizar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_biometric_sync_server_data_wizard" model="ir.actions.act_window">
        <field name="name">Sincronizar Datos del Servidor</field>
        <field name="res_model">biometric.sync.server.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
