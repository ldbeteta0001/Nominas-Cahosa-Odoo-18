<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- advance salary rule -->
        <record id="hr_payslip_rule_advance" model="hr.salary.rule">
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="name">Anticipo de sueldo</field>
            <field name="code">SAR</field>
            <field name="sequence" eval="190"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'SAR' in inputs</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = inputs['SAR'] and - (inputs['SAR'].amount)
            </field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="struct_id" ref="l10n_hn_hr_payroll.structure_month"/>
        </record>
        <!-- advance salary input type -->
        <record id="payslip_input_type_advance" model="hr.payslip.input.type">
            <field name="name">Anticipo de sueldo</field>
            <field name="code">SAR</field>
            <field name="struct_ids" eval="[(4, ref('l10n_hn_hr_payroll.structure_month'))]"/>
        </record>
        <!-- advance salary rule 13avo-->
        <record id="hr_payslip_rule_advance_13avo" model="hr.salary.rule">
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="name">Adelanto de 13 avo</field>
            <field name="code">SAR13AVO</field>
            <field name="sequence" eval="49"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'SAR13AVO' in inputs</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = inputs['SAR13AVO'] and - (inputs['SAR13AVO'].amount)
            </field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="struct_id" ref="l10n_hn_hr_payroll.structure_13avo"/>
        </record>

        <record id="payslip_input_type_advance_13avo" model="hr.payslip.input.type">
            <field name="name">Adelanto 13 Avo </field>
            <field name="code">SAR13AVO</field>
            <field name="struct_ids" eval="[(4, ref('l10n_hn_hr_payroll.structure_13avo'))]"/>
        </record>

        <!-- advance salary rule 14avo-->
        <record id="hr_payslip_rule_advance_14avo" model="hr.salary.rule">
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="name">Adelanto de 14 avo</field>
            <field name="code">SAR14AVO</field>
            <field name="sequence" eval="49"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'SAR14AVO' in inputs</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = inputs['SAR14AVO'] and - (inputs['SAR14AVO'].amount)
            </field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="struct_id" ref="l10n_hn_hr_payroll.structure_14avo"/>
        </record>

        <record id="payslip_input_type_advance_14avo" model="hr.payslip.input.type">
            <field name="name">Adelanto 14 Avo </field>
            <field name="code">SAR14AVO</field>
            <field name="struct_ids" eval="[(4, ref('l10n_hn_hr_payroll.structure_14avo'))]"/>
        </record>

        <!-- salary structure -->
        <record id="hr_payroll_structure_view_form" model="ir.ui.view" >
            <field name="name">hr.payroll.structure.form.inherit</field>
            <field name="model">hr.payroll.structure</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_employee_grade_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type_id']" position="after">
                    <field name="max_percent"/>
                    <field name="advance_date"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
