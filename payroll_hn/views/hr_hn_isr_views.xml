<?xml version='1.0' encoding='utf-8'?>
<odoo>

	<!--VISTA LIST ISR LINES-->
	<record id="hn_isr_lines_list_view" model="ir.ui.view">
		<field name="name">hn.isr.lines.list.view</field>
		<field name="model">hn.isr.line</field>
		<field name="arch" type="xml">
			 <list string="Líneas ISR" delete="0" create="0" edit="0">
				<field name="employee_id" options="{'no_create': True}" optional="show" readonly="1"/>
				<field name="contract_id" options="{'no_create': True}" optional="hide" readonly="1"/>
				<field name="montly_salary" optional="show" string="Salario Mensual" sum="Total" readonly="1"/>
				<field name="months_worked" optional="hide" readonly="1"/>
				<field name="his_months_worked" optional="hide" readonly="1"/>
				<field name="months_to_divide" optional="hide" readonly="0"/>
				<field name="total_incomes" optional="show" sum="Total" readonly="1"/>
				<field name="other_income" optional="show" sum="Total" readonly="1"/>
				<field name="net_salary" optional="hide" sum="Total" readonly="1"/>
				<field name="medical_expense" optional="hide" readonly="1"/>
				<field name="amount_rap" optional="hide" sum="Total" readonly="1"/>
				<field name="amount_ivm" optional="hide" sum="Total" readonly="1"/>
				<field name="amount_membership" optional="hide" sum="Total" readonly="1"/>
				<field name="other_expenses" optional="hide" sum="Total" readonly="1"/>
				<field name="total_base" readonly="1" optional="show" sum="Total"/>
				<field name="total_tax" readonly="1" optional="hide" sum="Total"/>
				<field name="total_detained" readonly="0" optional="hide"/>
				<field name="isr_fee" optional="show" sum="Total" readonly="1"/>
			</list>
		</field>
	</record>

	<!-- Acción ISR LINES LIST-->
	<record id="hn_isr_lines_list_view_table_action" model="ir.actions.act_window">
		<field name="name">Líneas de tabla ISR</field>
		<field name="res_model">hn.isr.line</field>
		<field name="view_mode">list</field>
		<field name="domain">[('parent_id', '=', active_id)]</field>
		<field name="view_id" ref="hn_isr_lines_list_view"/>
		<field name="context">{'create': False}</field>
	</record>

	<!-- WIZARD ASSIGN VIEW ISR TABLE-->
	<record id="hr_hn_isr_assign_form_view" model="ir.ui.view">
        <field name="name">hr.hn.isr.assign.form.view</field>
        <field name="model">hr.hn.isr.assign</field>
        <field name="arch" type="xml">
            <form string="Asignar ISR a empleados">
                <separator string="Departamento" colspan="2"/>
                <div class="o_row">
                    <p class="text-muted w-50">Establece un departamento específico si desea seleccionar todos los empleados de este departamento (y subdepartamentos) a la vez.</p>
                    <field name="department_id" options="{'no_create': true, 'no_open': true}" nolabel="1"/>
                </div>
				<separator string="Pago Programado" colspan="2"/>
                <div class="o_row">
                    <p class="text-muted w-50">Establezca un Pago Programado específico si desea seleccionar todos los empleados de este Pago Programado a la vez.</p>
                    <field name="schedule_pay" required="True" nolabel="1"/>
                </div>
				<separator string="Aplicar en" colspan="2" invisible="schedule_pay != 'bi-weekly'"/>
                <div class="o_row" invisible="schedule_pay != 'bi-weekly'">
                    <p class="text-muted w-50">Establezca en cual quincena desea aplicar la deducción.</p>
                    <field name="apply_in" nolabel="1" required="schedule_pay == 'bi-weekly'"/>
                </div>
                <separator string="Empleados"/>
                <field name="employee_ids" nolabel="1">
                    <list>
                        <field name="name"/>
                        <field name="work_email"/>
                        <field name="department_id"/>
                    </list>
                </field>
                <footer>
                    <button string="Asignar" name="action_assign" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancelar" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hn_isr_assign_action" model="ir.actions.act_window">
        <field name="name">Asignar ISR a empleados</field>
        <field name="res_model">hr.hn.isr.assign</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_hn_isr_assign_form_view"/>
        <field name="target">new</field>
    </record>

	<!-- Action hr.contract -->
    <record id="action_isr_contract" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[('isr_id', '=', active_id)]</field>
    </record>

    <!-- vista form de isr -->
	<record id="hn_isr_form_view" model="ir.ui.view">
		<field name="name">hn.isr.form.view</field>
		<field name="model">hr.hn.isr</field>
		<field name="arch" type="xml">
			<form string="ISR">
				<header>
					<button name="action_active" type="object" string="Activar" class="oe_highlight" invisible="state == 'active'"/>
					<button name="action_draft" type="object" string="Desactivar" invisible="state != 'active'"/>
					<button name="get_isr_table" type="object" string="Recalcular Lineas" invisible="state == 'draft'"/>
					<button name="delete_lines" type="object" string="Borrar Lineas" invisible="not isr_line_ids"/>
					<button name="%(payroll_hn.hr_hn_isr_assign_action)d" type="action" string="Asignar" invisible="state == 'draft'"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="%(action_isr_contract)d" icon="fa-th-list" type="action">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="contract_count"/></span>
                                <span class="o_stat_text"> Contratos</span>
                            </div>
                        </button>

						<button class="oe_stat_button" name="%(hn_isr_lines_list_view_table_action)d" icon="fa-book" type="action">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Líneas ISR</span>
                            </div>
                        </button>
                    </div>
					<div class="oe_title">
						<h1>
							<field name="name" placeholder="ISR 2025" readonly="state != 'draft'"/>
						</h1>
					</div>

					<!-- Layout forzado de dos columnas usando Bootstrap -->
					<div class="container-fluid">
						<div class="row">
							<div class="col-md-6">
								<group string="ISR">
									<field name="currency_id" invisible="1"/>
									<field name="exempt_salary" string="Salario Exento" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/>
									<field name="medical_expense" string="Gastos Médicos" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/>
								</group>
							</div>
							<div class="col-md-6">
								<group string="Parametros">
									<field name="range_ids" string="Rangos" readonly="state != 'draft'" nolabel="1">
										<list editable="bottom">
											<field name="currency_id" readonly="1" column_invisible="1"/>
											<field name="amount_from" string="Desde" widget="monetary" options="{'currency_field': 'currency_id'}"/>
											<field name="amount_to" string="Hasta" widget="monetary" options="{'currency_field': 'currency_id'}"/>
											<field name="rate" string="Tasa %" widget="percentage"/>
										</list>
									</field>
								</group>
							</div>
						</div>
					</div>

					<!-- Notebook comentado temporalmente -->

					<notebook>
						<page name="Employees" string="Empleados">
							<field name="isr_line_ids">
								<list editable="bottom">
									<field name="employee_id" string="Empleado" options="{'no_create': True}" optional="show"/>
									<field name="contract_id" options="{'no_create': True}" optional="hide"/>
									<field name="montly_salary" string="Salario Mens." optional="show" sum="Total"/>
									<field name="months_worked" optional="hide" readonly="1"/>
									<field name="his_months_worked" optional="hide" readonly="1"/>
									<field name="months_to_divide" optional="hide" readonly="0"/>
									<field name="total_incomes" string="Salario Anual" optional="show" sum="Total"/>
									<field name="other_income" string="Otros Ingres." optional="show" sum="Total"/>
									<field name="net_salary" string="Total Ingresos" optional="hide" sum="Total"/>
									<field name="medical_expense" string="Gastos Médic." optional="hide"/>
									<field name="amount_rap" string="RAP" optional="hide" sum="Total"/>
									<field name="amount_ivm" string="Invalidez Veje." optional="hide" sum="Total"/>
									<field name="amount_membership" string="Colegiaturas" optional="hide" sum="Total"/>
									<field name="other_expenses" string="Otros Gast." optional="hide" sum="Total"/>
									<field name="total_base" string="Total Base Imp." readonly="1" optional="show" sum="Total"/>
									<field name="total_tax" readonly="1" optional="hide" sum="Total"/>
									<field name="total_detained" readonly="0" optional="hide"/>
									<field name="isr_fee" string="Deducción" optional="show" sum="Total" readonly="1"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

    <!-- vista list de isr -->
	<record id="hn_isr_list_view" model="ir.ui.view">
		<field name="name">hn.isr.list.view</field>
		<field name="model">hr.hn.isr</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="state" widget="badge" decoration-success="state == 'active'" decoration-primary="state == 'draft'"/>
			</list>
		</field>
	</record>

    <!-- accion de isr -->
    <record id="action_hn_isr" model="ir.actions.act_window">
		<field name="name">ISR</field>
		<field name="res_model">hr.hn.isr</field>
		<field name="view_mode">list,form</field>
	</record>

</odoo>