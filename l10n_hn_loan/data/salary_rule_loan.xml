<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="hr_rule_loan" model="hr.salary.rule">
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="name">Préstamo</field>
            <field name="code">LO</field>
            <field name="sequence" eval="190"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'LO' in inputs</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
                result = inputs['LO'] and - (inputs['LO'].amount)
            </field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="struct_id" ref="hr_contract.structure_type_employee"/>
        </record>

        <record id="payslip_input_type_loan" model="hr.payslip.input.type">
            <field name="name">Préstamo</field>
            <field name="code">LO</field>
            <field name="struct_ids" eval="[(4, ref('hr_contract.structure_type_employee'))]"/>
        </record>
    </data>
</odoo>