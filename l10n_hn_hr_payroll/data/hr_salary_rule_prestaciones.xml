    <record id="datec_l10n_hh_hr_payroll_total_month" model="hr.salary.rule">
        <field name="category_id" ref="BASIC_INF"/>
        <field name="name">TOTAL MENSUAL</field>
        <field name="code">TOTAL_MENSUAL</field>
        <field name="sequence">18</field>
        <field name="condition_select">none</field>
