    <record id="datec_l10n_hh_hr_payroll_month_rap" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="name">RAP</field>
        <field name="code">RAP</field>
        <field name="sequence">191</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = True</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
techo_rap = payslip._rule_parameter('T_RAP')
factor_rap = payslip._rule_parameter('F_RAP')
rap_aplicar = contract.wage - techo_rap
if rap_aplicar > 0:
    result = -(rap_aplicar * factor_rap/100)
else:
    result = 0
        </field>
        <field name="struct_id" ref="structure_month"/>
    </record>

