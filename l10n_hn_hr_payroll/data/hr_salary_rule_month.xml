    <record id="datec_l10n_hh_hr_payroll_month_ihss_rsa" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="name">IHSS R.A.S</field>
        <field name="code">IHSS_RAS</field>
        <field name="sequence">191</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = True</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
techo_ihss_rsa = payslip._rule_parameter('T_IHSS_RSA')
factor_ihss_rsa = payslip._rule_parameter('F_IHSS_RSA')
if contract.wage > techo_ihss_rsa:
    result = -(techo_ihss_rsa * factor_ihss_rsa/100)
else:
    result = -(BASIC * factor_ihss_rsa/100)
        </field>
        <field name="struct_id" ref="structure_month"/>
    </record>

