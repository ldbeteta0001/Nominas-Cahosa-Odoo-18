<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="view_res_bank_form">
            <field name="name">res.bank.form</field>
            <field name="model">res.bank</field>
            <field name="inherit_id" ref="base.view_res_bank_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bic']" position="after">
                    <field name="bank_sequence" readonly="1"/>
                    <field name="sequence_init" invisible="bank_sequence != False"/>
                    <button name="assign_sequence" type="object" string="Assign Sequence" invisible="bank_sequence != False"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>