<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_hn_bank_summary_view_form" model="ir.ui.view">
        <field name="name">l10n.hn.bank.summary.view.form</field>
        <field name="model">l10n.hn.bank.summary</field>
        <field name="arch" type="xml">
            <form string="Resumen del banco">
                <header>
                    <button string="Llevar a borrador" name="action_reset_to_draft" type="object" invisible="state != 'draft'" />
                    <button string="Imprimir" name="action_print_payslip" type="object" invisible="state != 'draft'" />
                    <button string="Imprimir txt" name="action_print_payslip_txt" type="object" invisible="state != 'draft'" />
                    <button string="Enviado el txt" name="action_send_txt" type="object"  />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" nolabel="1"/></h1>
                    </div>
                    <group>
                        <group>
                             <label for="date_from" string="Period"/>
                             <div>
                                 <field name="date_from" class="oe_inline" readonly="state != 'draft'"/> - <field name="date_to" class="oe_inline" readonly="state != 'draft'"/>
                             </div>
                            <field name="partner_bank_id" class="oe_inline" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="struct_id" readonly="state != 'draft'"/>
                            <field name="pdf_attachment_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Generation Complete" invisible="not bank_pdf_file">
                        <field name="bank_pdf_filename" invisible="1"/>
                        <field name="bank_txt_filename" invisible="1"/>
                        <group>
                           <p colspan="4" invisible="not bank_pdf_file">
                           Descargar el resumen del banco en PDF: <field name="bank_pdf_file" readonly="1" filename="bank_pdf_filename"/>
                           </p>
                        </group>
                        <group>
                           <p colspan="4" invisible="not bank_txt_file">
                           Descargar el fichero TXT a enviar al banco: <field name="bank_txt_file" readonly="1" filename="bank_txt_filename"/>
                           </p>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list no_open="1" editable="bottom">
                            <field name="employee_id" widget="many2one_avatar_user"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_hn_bank_summary_view_tree" model="ir.ui.view">
        <field name="name">l10n.hn.bank.summary.view.tree</field>
        <field name="model">l10n.hn.bank.summary</field>
        <field name="arch" type="xml">
            <list string="Resumen del banco">
                <field name="display_name" string="Name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="struct_id"/>
                <field name="state"/>
                <field name="state" widget="badge"
                        decoration-muted="state == 'draft'"
                        decoration-success="state == 'send'"/>
            </list>
        </field>
    </record>

    <record id="l10n_hn_bank_summary_action" model="ir.actions.act_window">
        <field name="name">Resumen del banco</field>
        <field name="res_model">l10n.hn.bank.summary</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

