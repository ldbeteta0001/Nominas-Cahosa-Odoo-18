<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.l10n_hn_hr_payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='struct_id']" position="after">
                <field name="overtime_hours_for_all"  />
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']/list/field[@name='amount']" position="replace">
                <field name="amount" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='account_info']/group/group/field[@name='company_id']" position="after">
                <field name="sent_to_the_bank" readonly="1"/>
            </xpath>
<!--            <field name='has_refund_slip' position="after">-->
<!--                <field name="l10n_hn_worked_days_leaves_count" invisible="1"/>-->
<!--            </field>-->
<!--            <xpath expr="//page[@name='worked_days_input']//list/field[@name='name']" position="after">-->
<!--                <field name="l10n_hn_leave_id"-->
<!--                    column_invisible="parent.l10n_hn_worked_days_leaves_count == 0 or parent.country_code != 'HN'"/>-->
<!--            </xpath>-->
        </field>
    </record>
</odoo>
