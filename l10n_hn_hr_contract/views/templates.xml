        <template id="template_list_of_quit" name="Página Portal">
            <t t-call="portal.portal_layout">
                <div class="container list_js_expense_class">
                    <div class="mb-2">
                        <a href="/create_quit/new" class="btn btn-primary">Adicionar renuncia</a>
                    </div>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>Fecha de renuncia</th>
                                <th>Fecha de renuncia</th>
                                <th>Fecha de renuncia esperada</th>
                                <th>Fecha de aceptada</th>
                                <th>Penalización</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="items" t-as="item">
                                <tr>
                                    <td>
                                        <input type="checkbox" t-att-id="'checkbox_' + str(item.id)"
                                               t-att-disabled="'disabled' if item.state != 'draft' else None"/>
                                    </td>
                                    <td style="display: none;">
                                        <t t-esc="item.employee_id"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.employee_id.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.quit_date"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.expected_date"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.accepted_date"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.penalty_to_be_applied"/>
                                    </td>
                                    <td name="quit_status">
                                        <t t-if="item.state == 'draft'" name="quit_status_draft">
                                            <span class="badge rounded-pill text-primary">
                                                <i class="fa fa-fw fa-star" aria-label="borrador" title="Borrador"
                                                   role="img"/>
                                                <span class="d-none d-md-inline">Borrador</span>
                                            </span>
                                        </t>
                                        <t t-if="item.state == 'open'" name="quit_status_open">
                                            <span class="badge rounded-pill text-bg-light">
                                                <i class="fa fa-fw fa-clock-o" aria-label="En proceso"
                                                   title="En proceso" role="img"/>
                                                <span class="d-none d-md-inline">En proceso</span>
                                            </span>
                                        </t>
                                        <t t-if="item.state == 'refuse'" name="quit_status_refuse">
                                            <span class="badge rounded-pill text-bg-danger">
                                                <i class="fa fa-fw fa-clock-o" aria-label="Rechazada" title="Rechazada"
                                                   role="img"/>
                                                <span class="d-none d-md-inline">Rechazada</span>
                                            </span>
                                        </t>
                                        <t t-elif="item.state == 'cancel'">
                                            <span class="badge rounded-pill text-bg-warning">
                                                <i class="fa fa-fw fa-remove" aria-label="Cancelado" title="Cancelado"
                                                   role="img"/>
                                                <span class="d-none d-md-inline">Cancelado</span>
                                            </span>
                                        </t>
                                        <t t-elif="item.state == 'accepted'">
                                            <span class="badge rounded-pill text-bg-success">
                                                <i class="fa fa-fw fa-circle text-success" aria-label="Aceptado"
                                                   title="Aceptado"
                                                   role="img"/>
                                                <span class="d-none d-md-inline">Aceptado</span>
                                            </span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Paginación -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <t t-foreach="range(total_pages)" t-as="p">
                                <li t-att-class="'page-item' + (' active' if page == p else '')">
                                    <a class="page-link" t-att-href="'/my/quit/list?page=' + str(p)">
                                        <t t-esc="p+1"/>
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </nav>
                </div>
            </t>
        </template>
    </data>
</odoo>
