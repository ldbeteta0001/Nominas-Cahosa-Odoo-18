<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <!-- Job Form View Inherit -->
        <record id="l10n_hn_hr_job_form" model="ir.ui.view">
            <field name="name">l10n.hn.hr.job.form</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="priority">30</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//div[hasclass('oe_title')]" position="after">
                        <group>
                            <field name="code" required="1" class="col-2"/>
                            <field name="position_id" required="1" options="{'no_create': True, 'no_create_edit':True}"/>
                        </group>
                    </xpath>
                </data>
            </field>
        </record>

