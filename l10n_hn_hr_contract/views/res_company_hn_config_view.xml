<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_company_hn_config_inherit_form">
            <field name="name">res.company.form.inherit</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="model">res.company</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='hide_fields']" position="after">
                    <field name="alert_contract"/>
                </xpath>
                <xpath expr="//notebook//page[@name='conf_honduras']" position="inside">
                    <group string="Notificación previa de renuncia">
                        <field name="previous_quit_notice_ids">
                            <list>
                                <field name="description"/>
                                <field name="years_of_service_start"/>
                                <field name="month_of_service_start"/>
                                <field name="years_of_service_end"/>
                                <field name="month_of_service_end"/>
                                <field name="previous_days"/>
                                <field name="penalty_to_be_applied"/>
                            </list>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
