<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VISTA HR.POSITION -->
    <record id="view_hr_position_form" model="ir.ui.view">
        <field name="name">hr_position.form</field>
        <field name="model">hr.position</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="code" required="True"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_position_tree" model="ir.ui.view">
        <field name="name">hr_position.tree</field>
        <field name="model">hr.position</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_hr_position_view_tree" model="ir.actions.act_window">
        <field name="name">Puesto</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.position</field>
    </record>

    <menuitem
            id="menu_hr_employee_position"
            action="action_hr_position_view_tree"
            parent="l10n_hn_hr.hr_menu_empleado_honduras"
            sequence="4"/>

</odoo>
