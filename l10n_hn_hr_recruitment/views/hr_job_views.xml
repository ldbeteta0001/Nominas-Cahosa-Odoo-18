<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<odoo>
    <data>
        <record id="l10n_hn_hr_job_form" model="ir.ui.view">
            <field name="name">l10n.hn.hr.job.form</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="priority">30</field>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='recruitment2']" position="inside">
                    <field name="internal_published"/>
                    <field name="date_published" invisible="not internal_published"/>
                    <field name="hr_survey_profile_id"/>
                </xpath>
            </field>
        </record>
       <record id="view_hr_job_form_inherit" model="ir.ui.view">
            <field name="name">hr.job.form.inherit</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Tipos de documentos">
                        <field name="document_type_ids">
                            <list>
                                <field name="document_type"/>
                                <field name="is_required"/>
                                <field name="qty"/>
                                <field name="job_id" invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <xpath expr="//group[@name='recruitment2']" position="inside">
                   <field name="no_of_recruit_perm"/>
                   <field name="no_of_recruit_temp"/>
               </xpath>
            </field>
       </record>
    </data>
</odoo>