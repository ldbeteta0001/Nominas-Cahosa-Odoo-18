<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_request_new_positions_form" model="ir.ui.view">
            <field name="name">request.new.positions.form</field>
            <field name="model">request.new.positions</field>
            <field name="arch" type="xml">
                <form string="Solicitud de Nuevas Posiciones">
                    <header>
                         <field name="state" widget="statusbar" options="{'clickable': '1'}" readonly="state != 'new'"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                            <field name="request_date" readonly="state != 'new'"/>
                            <field name="manager_id" readonly="state != 'new'"/>
                            <field name="department_id" readonly="state != 'new'"/>
                            <field name="position_id" readonly="state != 'new'"/>
                            <field name="state" readonly="state != 'new'"/>
                            <field name="date_processed" readonly="state != 'new'"/>
                            <field name="qty" readonly="state != 'new'"/>
                            </group>
                        </group>
                    </sheet>
                     <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_request_new_positions_tree" model="ir.ui.view">
            <field name="name">request.new.positions.tree</field>
            <field name="model">request.new.positions</field>
            <field name="arch" type="xml">
                <list string="Solicitud de Nuevas Posiciones">
                    <field name="request_date"/>
                    <field name="manager_id"/>
                    <field name="department_id"/>
                    <field name="position_id"/>
                    <field name="state"/>
                    <field name="date_processed"/>
                    <field name="qty"/>
                </list>
            </field>
        </record>

        <!-- Menu Item -->

        <!-- Window Action -->
        <record id="action_request_new_positions" model="ir.actions.act_window">
            <field name="name">Solicitud de Nuevas Posiciones</field>
            <field name="res_model">request.new.positions</field>
            <field name="view_mode">list,form</field>
        </record>
         <menuitem id="menu_request_new_positions" name="Solicitud de Nuevas Plazas" parent="hr_recruitment.menu_crm_case_categ0_act_job"
                  action="action_request_new_positions" groups="hr_recruitment.group_hr_recruitment_user"/>


    </data>
</odoo>
