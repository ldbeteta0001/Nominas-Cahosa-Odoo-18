<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
                   <!--    Security Rules -->

    <!-- Sale Order -->
    <record id="access_sale_order_portal" model="ir.model.access">
        <field name="name">sale.order portal access</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="group_id" ref="base.group_portal"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Project Task -->
    <record id="access_project_task_portal" model="ir.model.access">
        <field name="name">project.task portal access</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="group_id" ref="base.group_portal"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
     <record id="project_access_portal" model="ir.model.access">
        <field name="name">project.project portal read</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="group_id" ref="base.group_portal"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rule_project_portal_visibility" model="ir.rule">
        <field name="name">Portal Project Access</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('privacy_visibility', 'in', ('portal', 'public'))]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- HR Expense -->
    <record id="access_hr_expense_portal" model="ir.model.access">
        <field name="name">hr.expense portal access</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="group_id" ref="base.group_portal"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>


    <!-- Sale Orders -->
    <record id="portal_sale_order_rule" model="ir.rule">
        <field name="name">Portal: Own Sale Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id','child_of',[user.partner_id.id])]</field>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Project Tasks -->
        <record id="project_task_portal_rule" model="ir.rule">
        <field name="name">Portal: Own Tasks</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">['|', ('user_ids', 'in', [user.id]), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


    <!-- HR Expenses -->
    <record id="portal_hr_expense_rule" model="ir.rule">
        <field name="name">Portal: Own Expenses</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
