<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--         # employee weekly/schedule list view template                  -->

    <template id="weekly_schedule_list_view_temp_id" name="Weekly Schedule SOP">
        <t t-call="portal.portal_layout">

            <t t-if="checkouts" t-call="portal.portal_table">

                <thead>
                    <tr>
                        <th>Employee Name</th>
                        <th>Weekly Shift</th>
                        <th>#</th>
                        <th>#</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="checkouts" t-as="doc">
                        <td>
                            <span t-field="user.name"/>
                        </td>
                        <td>
                            <span t-field="doc.number_of_days"/>
                        </td>
                        <td>
                            <!--                            <span t-field="doc.number_of_days"/>-->
                        </td>
                        <td>
                            <span t-field="doc.number_of_days"
                                  class="badge badge-pill badge-info"/>
                        </td>
                    </tr>
                </tbody>
            </t>
            <t t-else="">
                <div class="alert alert-warning" role="alert">
                    There are no Record Found.
                </div>
            </t>
        </t>
    </template>

    <!--                     employee weekly/schedule form view template            -->

    <template id="ad_weekly_schedule_form_view_temp_id" name="Weekly Schedule Form View">
        <t t-call="portal.portal_layout">
            <div class="container mt-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="mt-3 text-start">
                        <a href="/my/home" class="btn btn-secondary">
                            <i class="fa fa-arrow-left me-1"></i>
                            Back to home
                        </a>
                    </div>
                    <h3>Weekly Schedules</h3>
                    <a href="/weekly-schedule/new" class="btn btn-primary">
                        <i class="fa fa-plus"/>
                        New Weekly Schedule Request
                    </a>
                </div>
                <t t-if="checkouts">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Resource</th>
                                <th>Role</th>
                                <th>From Date Time</th>
                                <th>To Date Time</th>
                                <th>Allocated Time</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="checkouts" t-as="doc">
                                <td>
                                    <span t-field="doc.resource_id"/>
                                </td>
                                <td>
                                    <span t-field="doc.role_id.name"/>
                                </td>
                                <td>
                                    <span t-field="doc.start_datetime"/>

                                </td>
                                <td>
                                    <span t-field="doc.end_datetime"/>
                                </td>
                                <td>
                                    <span t-field="doc.allocated_hours"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <t t-else="">
                    <div class="alert alert-warning" role="alert">
                        No Approved Record found.
                    </div>
                </t>
            </div>
        </t>
    </template>


    <!--    submit weekly schedule request template-->

    <template id="ad_weekly_schedule__template" name="Leave Request Form">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_create_leaves" t-value="'Request New Leave'"/>
            <div class="container mt-4 mb-4">
                <div class="mt-3 text-start">
                <a href="/weekly/schedule" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i>
                    Back
                </a>
            </div>
                <h3 class="mb-3">Request New Schedule</h3>
                <form action="/weekly-schedule/request" method="POST" class="oe_website_form form-horizontal">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="form-group row">
                        <label for="resource_id" class="col-sm-3 col-form-label">Resource</label>
                        <div class="col-sm-9">
                            <input type="text"
                                   class="form-control"
                                   readonly="1"
                                   t-att-value="request.env.user.employee_id.resource_id.name or 'N/A'"/>

                            <!-- Hidden field to actually submit the resource_id -->
                            <input type="hidden"
                                   name="resource_id"
                                   t-att-value="request.env.user.employee_id.resource_id.id"/>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="start_datetime" class="col-sm-3 col-form-label">From Date</label>
                        <div class="col-sm-9">
                            <input type="date" name="start_datetime" class="form-control" required="required"/>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="end_datetime" class="col-sm-3 col-form-label">To Date</label>
                        <div class="col-sm-9">
                            <input type="date" name="end_datetime" class="form-control" required="required"/>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="role_id" class="col-sm-3 col-form-label">Role</label>
                        <div class="col-sm-9">
                            <select name="role_id" class="form-control" required="required">
                                <option value="">Select Role</option>
                                <t t-foreach="request.env['planning.role'].sudo().search([])" t-as="lt">
                                    <option t-att-value="lt.id">
                                        <t t-esc="lt.name"/>
                                    </option>
                                </t>
                            </select>

                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="company_id" class="col-sm-3 col-form-label">Company</label>
                        <div class="col-sm-9">
                            <select name="company_id" class="form-control" required="required">
                                <option value="">Select Company</option>
                                <t t-foreach="request.env['res.company'].sudo().search([])" t-as="lt">
                                    <option t-att-value="lt.id">
                                        <t t-esc="lt.name"/>
                                    </option>
                                </t>
                            </select>

                        </div>
                    </div>


                    <div class="d-flex justify-content-center form-group row">
                        <div class="offset-sm-3 col-sm-9">
                            <button type="submit" class="btn btn-success mt-3">Submit Request</button>
                            <a href="/weekly/schedule" class="btn btn-secondary mt-3">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>


</odoo>