<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="ad_portal_sale_order_template" name="Portal Sale Orders">
        <t t-call="portal.portal_layout">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="mt-3 text-start">
                                    <a href="/my/home" class="btn btn-secondary">
                                        <i class="fa fa-arrow-left me-1"></i>
                                        Back to home
                                    </a>
                                </div>
                    <h3 class="mt-4 mb-4">My Sale Orders</h3>
                    <a href="/my/sales/dashboard/view" class="btn btn-primary">
                        <i class="fa "/>
                        Sales Dashboard
                    </a>

                    <a href="/sale/my/create" class="btn btn-primary">
                        <i class="fa fa-plus"/>
                        Create New Quotation
                    </a>
                </div>
<!--                filter section-->
                <form method="get" class="form-inline mb-3">
                    <div class="row">
                       <div class="col-md-2">
                            <input type="text" name="date_start"
                                   class="form-control"
                                   t-att-value="date_start or ''"
                                   placeholder="Date From"
                                   onfocus="(this.type='date')"
                                   onblur="if(!this.value)this.type='text'" />
                        </div>

                        <!-- Date To -->
                        <div class="col-md-2">
                            <input type="text" name="date_end"
                                   class="form-control"
                                   t-att-value="date_end or ''"
                                   placeholder="Date To"
                                   onfocus="(this.type='date')"
                                   onblur="if(!this.value)this.type='text'" />
                        </div>
                        <!-- State -->

                        <div class="col-md-2">
                        <select name="state" class="form-control mr-2">
                            <option value="">All States</option>
                            <t t-foreach="[('draft', 'Quotation'), ('sent', 'Quotation Sent'), ('sale', 'Sales Order'), ('cancel', 'Cancelled')]" t-as="st">
                                <option t-att-value="st[0]" t-att-selected="state == st[0]"><t t-esc="st[1]"/></option>
                            </t>
                        </select>
                        </div>
                        <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">Filter</button>
                        </div>
                    </div>
                    </form>

<!--            show the user quotation and orders-->
                <t t-if="orders">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>View</th>
                                <th>Edit/Pay</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="orders" t-as="order">
                                <tr>
                                    <td><t t-esc="order.name"/></td>
                                    <td><t t-esc="order.partner_id.name"/></td>
                                    <td><t t-esc="order.date_order"/></td>
                                    <td>
                                      <span t-attf-class="badge #{'bg-success' if order.state == 'sale' else 'bg-secondary'}">
                                        <t t-esc="dict(order.fields_get(allfields=['state'])['state']['selection'])[order.state]"/>
                                      </span>
                                    </td>

                                    <td><t t-esc="order.currency_id.symbol"/> <t t-esc="'{:,.2f}'.format(order.amount_total)"/></td>
                                    <td>
                                            <a t-attf-href="/view/my-quotation/{{ order.id }}" class="btn btn-sm btn-outline-primary">View</a>
                                     </td>
                                    <td>
                                        <t t-if="order.state in ['draft', 'sent']">
                                            <a t-attf-href="/customer/quotation/edit/{{order.id}}/"
                                               class="btn btn-sm btn-outline-primary">Edit/Pay
                                            </a>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3"></td> <!-- empty cells to align -->
                                <td class="fw-bold" style="text-align:right">
                                    Total:
                                </td>
                                <td class="fw-bold">
                                    <t t-esc="orders[0].currency_id.symbol"/>
                                    <t t-esc="'{:,.2f}'.format(total_amount)"/>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>

                    </table>
                </t>
                <t t-if="not orders">
                    <p class="alert alert-info">You don't have any sale orders yet.</p>
                </t>
            </div>
        </t>
    </template>


    <!--    new quotation creation form portal-->
<template id="ad_portal_create_sale_order_template" name="Portal Create Quotation">
    <t t-call="portal.portal_layout">
        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2>Create New Quotation</h2>
                <a href="/sale/my" class="btn btn-primary">
                    Back
                    <i class="fa fa-fw fa-caret-right"/>
                </a>
            </div>
            <form action="/portal/sale_order/create" method="POST">
                <div class="container mt-4">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label>Customer</label>
                            <select name="partner_id" class="form-control" required="required">
                                <option value="">Select Customer</option>
                                <t t-foreach="partners" t-as="partner">
                                    <option t-att-value="partner.id">
                                        <t t-esc="partner.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>Quotation Date</label>
                            <input type="date" name="order_date" class="form-control" required="required"/>
                        </div>
                    </div>

                    <!-- Order line template -->
                    <div id="order_lines_container">
                        <div class="order-line row mb-2">
                            <div class="col-md-3">
                                <label>Product</label>
                                <select name="product_id_0" class="form-control product-select" required="required">
                                    <option value="">Select product</option>
                                    <t t-foreach="products" t-as="product">
                                        <option t-att-value="product.id"
                                                t-att-data-price="product.lst_price"
                                                t-att-data-tax="', '.join(t.name for t in product.taxes_id)"
                                                t-att-data-qty="product.qty_available">
                                            <t t-esc="product.display_name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>Quantity</label>
                                <input type="number" name="quantity_0" min="1" value="1" class="form-control qty-input" required="required"/>
                            </div>
                            <div class="col-md-2">
                                <label>Unit Price</label>
                                <input type="text" class="form-control price-output" readonl="1"/>
                            </div>
                            <div class="col-md-1">
                                <label>Taxes</label>
                                <input type="text" class="form-control tax-output" readonly="1"/>
                            </div>
                            <div class="col-md-1">
                                <label>Ava Qty</label>
                                <input type="text" class="form-control available-qty-output" readonly="1"/>
                            </div>
                            <div class="col-md-2">
                                <label>Subtotal</label>
                                <input type="text" class="form-control subtotal-output" readonly="1"/>
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="button" class="btn btn-danger remove-line">×</button>
                            </div>
                        </div>
                    </div>

                    <div class="text-end mt-2">
                        <button type="button" class="btn btn-secondary" id="add_line_btn">
                            <i class="fa fa-plus"> </i> Add Product
                        </button>
                    </div>

                    <div class="d-flex justify-content-center form-group row">
                        <div class="offset-sm-3 col-sm-9">
                            <button type="submit" class="btn btn-success mt-3">Create Quotation</button>
                            <a href="/sale/my" class="btn btn-secondary mt-3">Cancel</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </t>

        <div id="product_options_template" style="display:none;">
            <t t-foreach="products" t-as="product">
                <option t-att-value="product.id"
                        t-att-data-price="product.lst_price"
                        t-att-data-tax="', '.join(t.name for t in product.taxes_id)"
                        t-att-data-qty="product.qty_available">
                    <t t-esc="product.display_name"/>
                </option>
            </t>
        </div>

<script>
<![CDATA[
    let lineIndex = 1;
    const productOptionsHTML = document.getElementById('product_options_template').innerHTML;

    function updateSubtotal(row) {
        const qtyInput = row.querySelector('.qty-input');
        const priceInput = row.querySelector('.price-output');
        const subtotalInput = row.querySelector('.subtotal-output');

        if (qtyInput && priceInput && subtotalInput) {
            const qty = parseFloat(qtyInput.value) || 0;
            const price = parseFloat(priceInput.value) || 0;
            const subtotal = qty * price;
            subtotalInput.value = subtotal.toFixed(2);
        }
    }

    document.getElementById('add_line_btn').addEventListener('click', function () {
        const container = document.getElementById('order_lines_container');
        const newLine = document.createElement('div');
        newLine.className = 'order-line row mb-2';
        newLine.innerHTML = `
            <div class="col-md-3">
                <label>Product</label>
                <select name="product_id_${lineIndex}" class="form-control product-select" required="required">
                    <option value="">Select product</option>
                    ${productOptionsHTML}
                </select>
            </div>
            <div class="col-md-2">
                <label>Quantity</label>
                <input type="number" name="quantity_${lineIndex}" min="1" value="1" class="form-control qty-input" required="required"/>
            </div>
            <div class="col-md-2">
                <label>Unit Price</label>
                <input type="text" class="form-control price-output" readonly/>
            </div>
            <div class="col-md-1">
                <label>Taxes</label>
                <input type="text" class="form-control tax-output" readonly/>
            </div>
            <div class="col-md-1">
                <label>Ava Qty</label>
                <input type="text" class="form-control available-qty-output" readonly/>
            </div>
            <div class="col-md-2">
                <label>Subtotal</label>
                <input type="text" class="form-control subtotal-output" readonly/>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="button" class="btn btn-danger remove-line">×</button>
            </div>
        `;
        container.appendChild(newLine);
        lineIndex++;
    });

    document.addEventListener('click', function (e) {
        if (e.target.classList.contains('remove-line')) {
            e.target.closest('.order-line').remove();
        }
    });

    document.addEventListener('change', function (e) {
        if (e.target.classList.contains('product-select')) {
            const row = e.target.closest('.order-line');
            const selectedOption = e.target.options[e.target.selectedIndex];
            const priceOutput = row.querySelector('.price-output');
            const taxOutput = row.querySelector('.tax-output');
            const qtyOutput = row.querySelector('.available-qty-output');

            if (priceOutput) priceOutput.value = selectedOption.getAttribute('data-price') || '0';
            if (taxOutput) taxOutput.value = selectedOption.getAttribute('data-tax') || '';
            if (qtyOutput) qtyOutput.value = selectedOption.getAttribute('data-qty') || '0';

            updateSubtotal(row);
        }

        if (e.target.classList.contains('qty-input')) {
            const row = e.target.closest('.order-line');
            updateSubtotal(row);
        }
    });
]]>
</script>
</template>





<template id="ad_portal_quotation_detail_template" name="Quotation Detail">
    <t t-call="portal.portal_layout">
        <div class="container mt-4">
            <div class="row mb-4 col-12">
                <div class="col-6">
                    <h2 class="mb-3">Quotation: <t t-esc="order.name"/></h2>
                    <ul class="list-unstyled">
                       <li><strong>Customer: </strong> <t t-esc="order.partner_id.name"/></li>
                        <li><strong>Date:</strong> <t t-esc="order.date_order.strftime('%Y-%m-%d')"/></li>
                        <li><strong>Status:</strong> <span class="badge bg-info text-white"><t t-esc="order.state.title()"/></span></li>
                    </ul>
                </div>
                <div class="col-6 text-end">
                <a href="/sale/my" class="btn btn-secondary">Back to Quotations</a>
                </div>
            </div>

            <div class="table-responsive">
                <h4>Products</h4>
                <table class="table table-bordered table-hover table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th>Product</th>
                            <th>Description</th>
                            <th class="text-center">Ordered</th>
                            <th class="text-center">Delivered</th>
                            <th class="text-center">Invoiced</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Taxes</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="order.order_line" t-as="line">
                            <tr>
                                <td><t t-esc="line.product_id.display_name"/></td>
                                <td><t t-esc="line.name"/></td>
                                <td class="text-center"><t t-esc="line.product_uom_qty"/></td>
                                <td class="text-center"><t t-esc="line.qty_delivered"/></td>
                                <td class="text-center"><t t-esc="line.qty_invoiced"/></td>
                                <td class="text-end"><t t-esc="line.price_unit"/></td>
                                <td class="text-end"><t t-esc="', '.join(t.name for t in line.tax_id)"/></td>
                                <td class="text-end"><t t-esc="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-end"><strong>Untaxed Amount:</strong></td>
                            <td class="text-end"><t t-esc="order.amount_untaxed"/> <t t-esc="order.currency_id.symbol"/></td>
                        </tr>
                        <tr>
                            <td colspan="7" class="text-end"><strong>Tax:</strong></td>
                            <td class="text-end"><t t-esc="order.amount_tax"/> <t t-esc="order.currency_id.symbol"/></td>
                        </tr>
                        <tr>
                            <td colspan="7" class="text-end"><strong>Total (Incl. Tax):</strong></td>
                            <td class="text-end"><t t-esc="order.amount_total"/> <t t-esc="order.currency_id.symbol"/></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-end mt-4">
                <a href="/sale/my" class="btn btn-secondary">Back to Quotations</a>
            </div>
        </div>
    </t>
</template>



    <template id="portal_sales_dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <!-- Custom CSS for Dashboard -->
            <style>
                .sales-dashboard {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                min-height: 100vh;
                padding: 2rem 0;
                }

                .dashboard-header {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                border-radius: 15px;
                padding: 2rem;
                margin-bottom: 2rem;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                }

                .dashboard-title {
                background: linear-gradient(45deg, #667eea, #764ba2);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                font-size: 2.5rem;
                font-weight: 700;
                margin: 0;
                text-align: center;
                }

                .dashboard-subtitle {
                color: #6c757d;
                text-align: center;
                margin-top: 0.5rem;
                font-size: 1.1rem;
                }

                .stats-card {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                border: none;
                border-radius: 20px;
                padding: 0;
                overflow: hidden;
                transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
                position: relative;
                margin-bottom: 2rem;
                }

                .stats-card:hover {
                transform: translateY(-10px) scale(1.02);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
                }

                .stats-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 5px;
                background: var(--card-gradient);
                transition: height 0.3s ease;
                }

                .stats-card:hover::before {
                height: 8px;
                }

                .stats-card.info {
                --card-gradient: linear-gradient(45deg, #36d1dc, #5b86e5);
                }

                .stats-card.success {
                --card-gradient: linear-gradient(45deg, #11998e, #38ef7d);
                }

                .stats-card.danger {
                --card-gradient: linear-gradient(45deg, #fc466b, #3f5efb);
                }

                .stats-card.warning {
                --card-gradient: linear-gradient(45deg, #fdbb2d, #22c1c3);
                }

                .card-body-custom {
                padding: 2rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                }

                .card-content {
                flex: 1;
                }

                .card-header-custom {
                font-size: 0.9rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: #6c757d;
                margin-bottom: 0.5rem;
                }

                .card-number {
                font-size: 3rem;
                font-weight: 800;
                line-height: 1;
                background: var(--card-gradient);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                margin-bottom: 0.5rem;
                }

                .card-description {
                color: #6c757d;
                font-size: 0.9rem;
                margin-bottom: 1rem;
                }

                .card-content {
                flex: 1;
                }

                .card-header-custom {
                font-size: 0.85rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: #6c757d;
                margin-bottom: 0.4rem;
                }

                .card-number {
                font-size: 2.5rem;
                font-weight: 800;
                line-height: 1;
                background: var(--card-gradient);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                margin-bottom: 0.4rem;
                }

                .card-description {
                color: #6c757d;
                font-size: 0.8rem;
                margin-bottom: 0.8rem;
                }

                .card-icon {
                font-size: 3rem;
                opacity: 0.1;
                position: absolute;
                right: 1rem;
                top: 50%;
                transform: translateY(-50%);
                transition: all 0.3s ease;
                }

                .stats-card:hover .card-icon {
                opacity: 0.2;
                transform: translateY(-50%) rotate(10deg) scale(1.1);
                }

                .card-action {
                padding: 8px 16px;
                border-radius: 25px;
                text-decoration: none;
                font-weight: 600;
                font-size: 0.85rem;
                transition: all 0.3s ease;
                border: 2px solid transparent;
                background: var(--card-gradient);
                color: white;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                }

                .card-action:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
                text-decoration: none;
                color: white;
                }

                .back-button {
                background: rgba(255, 255, 255, 0.9);
                border: 2px solid rgba(255, 255, 255, 0.3);
                color: #333;
                padding: 12px 24px;
                border-radius: 50px;
                font-weight: 600;
                transition: all 0.3s ease;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                margin-bottom: 1rem;
                }

                .back-button:hover {
                background: white;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
                text-decoration: none;
                color: #333;
                }

                .pulse-animation {
                animation: pulse 2s infinite;
                }

                @keyframes pulse {
                0% { box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1); }
                50% { box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2); }
                100% { box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1); }
                }

                .stats-grid {
                gap: 2rem;
                }

                @media (max-width: 768px) {
                .dashboard-title {
                font-size: 2rem;
                }

                .card-number {
                font-size: 2rem;
                }

                .stats-grid {
                gap: 0.5rem;
                margin: 0;
                }

                .stats-grid > [class*="col-"] {
                padding: 0.5rem;
                }

                .card-body-custom {
                padding: 1.25rem 1rem;
                }

                .col-md-4 {
                margin-bottom: 1rem;
                }
                }

                @media (max-width: 576px) {
                .col-md-4 {
                flex: 0 0 100%;
                max-width: 100%;
                }

                .card-number {
                font-size: 1.8rem;
                }

                .card-body-custom {
                padding: 1rem 0.8rem;
                }
                }

                @media (min-width: 992px) {
                .stats-grid > [class*="col-"] {
                max-width: 32%;
                flex: 0 0 32%;
                }
                }

                .floating-elements {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
                z-index: -1;
                }

                .floating-element {
                position: absolute;
                background: rgba(255, 255, 255, 0.1);
                border-radius: 50%;
                animation: float 6s ease-in-out infinite;
                }

                .floating-element:nth-child(1) {
                width: 80px;
                height: 80px;
                top: 10%;
                left: 10%;
                animation-delay: 0s;
                }

                .floating-element:nth-child(2) {
                width: 120px;
                height: 120px;
                top: 20%;
                right: 10%;
                animation-delay: 2s;
                }

                .floating-element:nth-child(3) {
                width: 100px;
                height: 100px;
                bottom: 10%;
                left: 20%;
                animation-delay: 4s;
                }

                @keyframes float {
                0%, 100% { transform: translateY(0px) rotate(0deg); }
                50% { transform: translateY(-20px) rotate(180deg); }
                }
            </style>

            <div class="sales-dashboard">
                <!-- Floating Background Elements -->
                <div class="floating-elements">
                    <div class="floating-element"></div>
                    <div class="floating-element"></div>
                    <div class="floating-element"></div>
                </div>

                <div class="container">
                    <!-- Header Section -->
                    <div class="dashboard-header">
                        <a href="/sale/my" class="back-button">
                            <i class="fa fa-arrow-left"></i>
                            Back to Orders
                        </a>
                        <h1 class="dashboard-title">Sales Dashboard</h1>
                        <p class="dashboard-subtitle">Your sales performance at a glance</p>
                    </div>

                    <!-- Stats Cards Grid - Three Cards in One Row -->
                    <div class="row stats-grid justify-content-center">
                        <!-- Monthly Revenue Card -->

                        <div class="col-lg-4 col-md-4 col-sm-12 mb-3">
                            <div class="card stats-card info">
                                <div class="card-body-custom">
                                    <div class="card-content">
                                        <div class="card-header-custom">Monthly Revenue</div>
                                        <div class="card-number">
                                            <t t-esc="'%0.2f' % monthly_revenue"/>
                                        </div>
                                        <div class="card-description">Revenue this month</div>
                                        <a href="/sale/my?state=sale" class="card-action">
                                            <i class="fa fa-eye"></i>
                                            View Details
                                        </a>
                                    </div>
                                    <i class="fa fa-line-chart card-icon"></i>
                                </div>
                            </div>
                        </div>
                        <!-- Confirmed Sales Card -->
                        <div class="col-lg-4 col-md-4 col-sm-12 mb-3">
                            <div class="card stats-card success pulse-animation">
                                <div class="card-body-custom">
                                    <div class="card-content">
                                        <div class="card-header-custom">Confirmed Sales</div>
                                        <div class="card-number" t-esc="sale_count or 0"></div>
                                        <div class="card-description">Successfully converted orders</div>
                                        <a href="/sale/my?state=sale" class="card-action">
                                            <i class="fa fa-check-circle"></i>
                                            View Orders
                                        </a>
                                    </div>
                                    <i class="fa fa-shopping-cart card-icon"></i>
                                </div>
                            </div>
                        </div>
                        <!-- Draft Quotations Card -->
                        <div class="col-lg-4 col-md-4 col-sm-12 mb-3">
                            <div class="card stats-card info">
                                <div class="card-body-custom">
                                    <div class="card-content">
                                        <div class="card-header-custom">Draft Quotations</div>
                                        <div class="card-number" t-esc="draft_count or 0"></div>
                                        <div class="card-description">Pending customer approval</div>
                                        <a href="/sale/my?state=draft" class="card-action">
                                            <i class="fa fa-eye"></i>
                                            View Details
                                        </a>
                                    </div>
                                    <i class="fa fa-file-text-o card-icon"></i>
                                </div>
                            </div>
                        </div>


                        <!-- Cancelled Orders Card -->
                        <div class="col-lg-4 col-md-4 col-sm-12 mb-3">
                            <div class="card stats-card danger">
                                <div class="card-body-custom">
                                    <div class="card-content">
                                        <div class="card-header-custom">Cancelled Orders</div>
                                        <div class="card-number" t-esc="cancelled_count or 0"></div>
                                        <div class="card-description">Orders that were cancelled</div>
                                        <a href="/sale/my?state=cancel" class="card-action">
                                            <i class="fa fa-times-circle"></i>
                                            View Cancelled
                                        </a>
                                    </div>
                                    <i class="fa fa-ban card-icon"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Add some JavaScript for enhanced interactivity -->
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                // Add counter animation
                const numbers = document.querySelectorAll('.card-number');
                numbers.forEach(function(number) {
                const finalValue = parseInt(number.textContent);
                let currentValue = 0;
                const increment = Math.ceil(finalValue / 30);

                const timer = setInterval(function() {
                currentValue += increment;
                if (currentValue >= finalValue) {
                number.textContent = finalValue;
                clearInterval(timer);
                } else {
                number.textContent = currentValue;
                }
                }, 50);
                });

                // Add hover effects
                const cards = document.querySelectorAll('.stats-card');
                cards.forEach(function(card) {
                card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-10px) scale(1.02)';
                });

                card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
                });
                });
                });
            </script>
        </t>
    </template>


    <!--    edit quotation template-->
    <template id="portal_customer_edit_template" name="Edit Quotation">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h2>Edit Quotation:
                    <t t-esc="order.name"/>
                </h2>

                <form id="edit-quotation-form" action="/portal/customer_order/update" method="post">
                    <input type="hidden" name="order_id" t-att-value="order.id"/>

                    <table class="table table-bordered" id="quotation-lines-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Unit Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="order.order_line" t-as="line">
                                <tr t-att-data-line-id="line.id">
                                    <td>
                                        <select t-att-name="'product_%d' % line.id" class="form-select product-select">
                                            <t t-foreach="request.env['product.product'].sudo().search([])" t-as="p">
                                                <option t-att-value="p.id" t-att-selected="p.id == line.product_id.id">
                                                    <t t-esc="p.display_name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <input type="number" t-att-name="'qty_%d' % line.id"
                                               t-att-value="line.product_uom_qty" class="form-control"/>
                                    </td>
                                    <td class="text-end">
                                        <input type="number" t-att-name="'price_%d' % line.id"
                                               t-att-value="line.price_unit" class="form-control price-field"
                                               readonly="readonly"/>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-danger btn-sm remove-line">Remove</button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="mt-2">
                        <button type="button" id="add-line" class="btn btn-primary">Add Product</button>
                    </div>

                    <div class="text-end mt-3">
                        <button type="submit" class="btn btn-success">Save/Pay</button>
                        <a href="/sale/my" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>

            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                const tableBody = document.querySelector('#quotation-lines-table tbody');
                const addBtn = document.getElementById('add-line');

                // Fetch product list from backend
                const productList =<t t-raw="json.dumps(request.env['product.product'].sudo().search_read([], ['id', 'display_name', 'lst_price']))"/>
                ;

                function updatePrice(selectElem) {
                const productId = selectElem.value;
                const row = selectElem.closest('tr');
                if (!productId) {
                row.querySelector('.price-field').value = 0;
                return;
                }
                const product = productList.find(p => p.id === parseInt(productId));
                if (product) {
                row.querySelector('.price-field').value = product.lst_price;
                }
                }

                // Attach events to existing rows
                tableBody.querySelectorAll('.product-select').forEach(select => {
                select.addEventListener('change', function() {
                updatePrice(this);
                });
                });

                tableBody.querySelectorAll('.remove-line').forEach(btn => {
                btn.addEventListener('click', function() {
                btn.closest('tr').remove();
                });
                });

                // Add new product row
                addBtn.addEventListener('click', function() {
                const uniqueId = new Date().getTime();
                const newRow = document.createElement('tr');

                newRow.innerHTML = `
                <td>
                    <select name="new_product_${uniqueId}" class="form-select product-select">
                        <option value="">Select a Product</option>
                        ${productList.map(p => `<option value="${p.id}">${p.display_name}</option>`).join('')}
                    </select>
                </td>
                <td class="text-center">
                    <input type="number" name="new_qty_${uniqueId}" value="1" class="form-control"/>
                </td>
                <td class="text-end">
                    <input type="number" name="new_price_${uniqueId}" value="0" class="form-control price-field"
                           readonly="readonly"/>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm remove-line">Remove</button>
                </td>
                `;

                // Attach event to new select
                newRow.querySelector('.product-select').addEventListener('change', function() {
                updatePrice(this);
                });

                // Attach event to new remove button
                newRow.querySelector('.remove-line').addEventListener('click', function() {
                newRow.remove();
                });

                tableBody.appendChild(newRow);
                });
                });
            </script>
        </t>
    </template>



