<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<odoo>

    <template id="report_expense_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page o_content_pdf">
                        <div class="oe_structure"></div>
                        <h3><span t-out="o.name">Business Trip</span></h3>
                        <div class="row o_header">
                            <div class="col-6">
                                <div class="row">
                                    <div class="col-3 fw-bold"><span>Employee:</span> </div>
                                    <div class="col-9 text-muted"><span t-field="o.employee_id.name">Marc Demo</span></div>
                                </div>
                                <div class="row" t-if="o.accounting_date">
                                    <div class="col-3 fw-bold"><span>Date:</span></div>
                                    <div class="col-9 text-muted"><span t-field="o.accounting_date">2023-08-11</span></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="row" t-if="o.user_id.name">
                                    <div class="col-3 fw-bold"><span>Manager:</span></div>
                                    <div class="col-9 text-muted"><span t-field="o.user_id">Mitchell Admin</span></div>
                                </div>
                                <div class="row">
                                    <div class="col-3 fw-bold"><span>Paid by:</span></div>
                                    <div class="col-9 text-muted"><span t-field="o.payment_mode">Credit Card</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="row">
                                    <div class="col-3 fw-bold"><span>Place and date:</span> </div>
                                    <div class="col-9 text-muted"><span t-field="o.place_and_date"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-3 fw-bold"><span>Travel to:</span></div>
                                    <div class="col-9 text-muted"><span t-field="o.travel_to"/></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="row">
                                    <div class="col-3 fw-bold"><span>Reason for the trip:</span></div>
                                    <div class="col-9 text-muted"><span t-field="o.reason_description"/></div>
                                </div>
                                <div class="row">
                                    <div class="col-3 fw-bold"><span>Range date:</span></div>
                                    <div class="col-9 text-muted"><span t-field="o.date_ini"/><span> - </span><span t-field="o.date_end"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="oe_structure"></div>

                        <table class="o_table">
                            <thead>
                                <tr>
                                    <th class="text-start">Date</th>
                                    <th class="text-start">Name</th>
                                    <th class="text-end">Approved rate</th>
                                    <th class="text-end">Quantity Person</th>
                                    <th class="text-end">Quantity Days</th>
                                    <t t-set="foreign_currencies" t-value="o.expense_line_ids.currency_id - o.company_currency_id"/>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.expense_line_ids" t-as="line">
                                    <td class="text-start"><span t-field="line.date"></span></td>
                                    <td t-att-class="'text-start' + (' o_overflow' if len(line.name) > 30 else '')">
                                        <span t-field="line.name">Flight Ticket</span><br/>
                                        <span>
                                            <span t-foreach="line.analytic_distribution" t-as="distribution">
                                                <span t-out="line.env['account.analytic.account'].browse(int(distribution))[0].name">Analytic Account Name</span>:
                                                <span t-out="line.analytic_distribution.get(distribution)">50%</span>
                                            </span>
                                        </span>
                                    </td>
                                    <td class="text-end"><span t-field="line.approved_rate">$100.00</span></td>
                                    <td class="text-end"><span t-field="line.qty_person">1</span></td>
                                    <td class="text-end"><span t-field="line.qty_days">1</span></td>

                                    <td t-if="foreign_currencies" class="text-end">
                                        <span t-field="line.total_amount_currency" t-options='{"widget": "monetary", "display_currency": line.currency_id}'>$120.00</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.sub_total_viatic_amount" t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'>$100.00</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="oe_structure"></div>
                        <div class="row justify-content-end o_total">
                            <div class="col-4">
                                <div class="oe_structure"></div>
                                <table class="o_subtable">
                                    <tbody>
                                        <tr class="fw-bold">
                                            <td>Total</td>
                                            <td class="text-end">
                                                <span t-field="o.total_amount_viatic" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>$600.00</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="oe_structure"></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_hr_expense_sheet" model="ir.actions.report">
        <field name="name">Expenses Viatic Report</field>
        <field name="model">hr.hn.viatic</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_hn_viatic_portal.report_expense_sheet</field>
        <field name="report_file">hr_hn_viatic_portal.report_expense_sheet</field>
        <field name="print_report_name">'Viatic - %s - %s' % (object.employee_id.name, (object.name).replace('/', ''))</field>
        <field name="binding_model_id" ref="model_hr_hn_viatic"/>
        <field name="binding_type">report</field>
    </record>
</odoo>