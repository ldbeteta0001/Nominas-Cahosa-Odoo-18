<odoo>
    <record id="hr_expense_sheet_form_inherit_viatic" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.inherit.viatic</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <!-- Localización: Añadir el campo al lado de 'employee_id' -->
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="viatic_id" string="Viatic Reference" 
                       invisible="not viatic_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
