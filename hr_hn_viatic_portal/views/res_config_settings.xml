<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<odoo>
    <data>
        <record id="res_config_settings_viatic_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.viatic.view.form.inherit.hr.expense</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="86"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='hr_expense']" position="inside">
                    <block id="viatic_account" title="Viatic Account" name="viatic_account">
                            <setting company_dependent="1"
                                     string="Viatic Account">
                                <field name="account_viatic_id"/>
                            </setting>
                            <setting company_dependent="1" string="Viatic Cash and Banck Journal Account">
                                <field name="journal_viatic_cash_bank_id"/>
                            </setting>
                        </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>