<odoo>
    <data>
        <template id="hr_hn_portal_expense_my_home_sale" name="Expense" customize_show="True"
                  inherit_id="portal.portal_my_home" priority="20">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-call="hr_hn_viatic_portal.my_custom_viatic_template">
                </t>
            </xpath>
        </template>
        <template id="my_custom_viatic_template" name="Expense ">
            <div class="o_portal_category row g-2 mt-3" id="expense_client">
                <div class="o_portal_index_card col-md-6 order-2">
                    <a href="/my/viatic/list" title="Sus gastos"
                       class="d-flex justify-content-start gap-2 gap-md-3 align-items-center py-3 pe-2 px-md-3 h-100 rounded text-decoration-none text-reset text-bg-light">
                        <div class="o_portal_icon align-self-start">
                            <img src="/hr_hn_viatic_portal/static/src/img/viatic.jpeg" width="64" height="64"/>
                        </div>
                        <div>
                            <h5 class="mt-0 mb-1 d-flex gap-2">
                                <span>Sus viaticos</span>
                            </h5>
                            <p class="m-0 text-600">
                                Solicite el pago de sus viaticos, o dele seguimiento
                            </p>
                        </div>
                    </a>
                </div>
            </div>
        </template>
        <template id="template_list_of_viatic" name="Página Portal">
            <t t-call="portal.portal_layout">
                <div class="container list_js_expense_class">
                    <div class="mb-2">
                        <a href="/create_viatic_hr_expense/new" class="btn btn-primary">Add Viatic Expense</a>

                    </div>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sel.</th>
                                <th>Nombre</th>
                                <th>Lugar y fecha</th>
                                <th>Motivo del viaje</th>
                                <th>Total aprovado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="items" t-as="item">
                                <tr>
                                    <td>
                                        <input type="checkbox" t-att-id="'checkbox_' + str(item.id)"
                                               t-att-disabled="'disabled' if item.state != 'draft' else None"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.place_and_date"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.reason_description"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.total_amount_viatic"/>
                                    </td>

                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Paginación -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <t t-foreach="range(total_pages)" t-as="p">
                                <li t-att-class="'page-item' + (' active' if page == p else '')">
                                    <a class="page-link" t-att-href="'/my/expense/list?page=' + str(p)">
                                        <t t-esc="p+1"/>
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </nav>

                </div>
            </t>
        </template>
    </data>
</odoo>
