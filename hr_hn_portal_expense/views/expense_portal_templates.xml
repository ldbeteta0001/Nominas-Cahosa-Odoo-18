<odoo>
    <data>
        <template id="hr_hn_portal_expense_my_home_sale" name="Expense" customize_show="True"
                  inherit_id="portal.portal_my_home" priority="20">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-call="hr_hn_portal_expense.my_custom_template">
                </t>
            </xpath>
        </template>
        <template id="my_custom_template" name="Expense ">
            <div class="o_portal_category row g-2 mt-3" id="expense_client">
                <div class="o_portal_index_card col-md-6 order-2">
                    <a href="/my/expense/list" title="Sus gastos"
                       class="d-flex justify-content-start gap-2 gap-md-3 align-items-center py-3 pe-2 px-md-3 h-100 rounded text-decoration-none text-reset text-bg-light">
                        <div class="o_portal_icon align-self-start">
                            <img src="/hr_expense/static/description/icon.png" width="64" height="64"/>
                        </div>
                        <div>
                            <h5 class="mt-0 mb-1 d-flex gap-2">
                                <span>Sus gastos</span>
                            </h5>
                            <p class="m-0 text-600">
                                Solicite el pago de sus gastos, o dele seguimiento
                            </p>
                        </div>
                    </a>
                </div>
            </div>
        </template>

        <template id="template_list_of_expense" name="Página Portal">
            <t t-call="portal.portal_layout">
                <div class="container list_js_expense_class">
                    <div class="mb-2">
                        <a href="/create_hr_expense/new" class="btn btn-primary">Agregar gasto</a>
<!--                        <a href="/create_viatic_hr_expense/new" class="btn btn-primary">Add Viatic Expense</a>-->
                        <a href='#' class="btn btn-primary d-none" id="create_info_expense">Create Info</a>
                    </div>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sel.</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Total</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="items" t-as="item">
                                <tr>
                                    <td>
                                        <input name="checkbox_expense" type="checkbox"
                                               t-att-id="'checkbox_' + str(item.id)"
                                               t-att-disabled="'disabled' if item.state != 'draft' else None"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.description"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.total_amount_currency"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.date"/>
                                    </td>
                                    <td>
                                        <t t-esc="item.state"/>
                                    </td>
                                    <td>
                                        <a t-att-href="'/detail/expense?expense_id=' + str(item.id)"
                                           class="btn btn-primary">Ver detalle
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Paginación -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <t t-foreach="range(total_pages)" t-as="p">
                                <li t-att-class="'page-item' + (' active' if page == p else '')">
                                    <a class="page-link" t-att-href="'/my/expense/list?page=' + str(p)">
                                        <t t-esc="p+1"/>
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </nav>

                </div>
            </t>
        </template>

        <template id="form_hr_expense_custom_portal_user" name="Custom form expense">
            <t t-call="portal.portal_layout">

                <form method="post" enctype="multipart/form-data" class="o_mark_required needs-validation" data-mark="*"
                      data-pre-fill="true" data-model_name="hr.expense">
                    <div class="expense_form_js_class">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" name="name"/>
                            <p class="d-none" id='input_name'/>
                        </div>
                        <div class="mb-3">
                            <label for="date" class="form-label">Date</label>
                            <input type="date" class="form-control" id="date" name="date"/>
                            <p class="d-none" id='input_date'/>
                        </div>
                        <div class="mb-3">
                            <label for="product_id" class="form-label">Category</label>
                            <select class="form-select" id="product_id" name="product_id">
                                <t t-foreach="product_ids" t-as="product">
                                    <option t-att-value="product.id">
                                        <t t-esc="product.display_name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div id="quantity_id" class="mb-3 d-none">
                            <label for="quantity" class="form-label">Quantity</label>
                            <input type="number" step="0.01" class="form-control" id="quantity" name="quantity"/>
                            <p class="d-none" id='input_quantity'/>
                        </div>
                        <div class="mb-3">
                            <label for="total_amount_currency" class="form-label">Total Amount in Currency</label>
                            <input type="number" step="1" class="form-control" id="total_amount_currency"
                                   name="total_amount_currency" min="0"/>
                            <p class="d-none" id='input_amount_currency'/>
                        </div>
                        <div class="mb-3">
                            <label for="currency_id" class="form-label">Currency</label>
                            <select class="form-select" id="currency_id" name="currency_id">
                                <t t-foreach="currency_ids" t-as="currency_id">
                                    <t t-if="default_currency_id.id == currency_id">
                                        <option t-att-value="currency_id.id" selected="1">
                                            <t t-esc="currency_id.name"/>
                                        </option>
                                    </t>
                                    <t t-else="">
                                        <option t-att-value="currency_id.id">
                                            <t t-esc="currency_id.name"/>
                                        </option>
                                    </t>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Payment Mode</label>
                            <t t-foreach="payment_mode_ids" t-as="payment_mode">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="payment_mode"
                                           t-att-id="payment_mode.id" t-att-value="payment_mode.value"/>
                                    <label class="form-check-label" t-att-for="payment_mode.id">
                                        <t t-esc="payment_mode.name"/>
                                    </label>
                                </div>
                            </t>
                            <p class="d-none" id="input_payment_mode"/>

                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="3"/>
                            <p class="d-none" id="input_description"/>
                        </div>
                        <div class="mb-3">
                            <label for="tax_ids" class="form-label">Taxes</label>
                            <select class="form-select" id="tax_ids" name="tax_ids" multiple="multiple">
                                <t t-foreach="tax_ids" t-as="tax_id">
                                    <option t-att-value="tax_id.id">
                                        <t t-esc="tax_id.name"/>
                                    </option>
                                </t>
                            </select>
                            <small id="opcionesHelp" class="form-text text-muted">Mantén presionado Ctrl (o Cmd en Mac)
                                para seleccionar múltiples opciones.
                            </small>
                        </div>
                        <div class="mb-3">
                            <label for="archivo_adjunto" class="form-label">Attached File</label>
                            <input class="form-control" type="file" id="archivo_adjunto" name="archivo_adjunto"
                                   multiple="multiple"/>
                        </div>
                        <button type="submit" class="btn btn-primary save_all">Submit</button>
                        <button class="btn btn-primary save_and_new">Save and new</button>
                        <div class="form-group row mt-2">
                            <table class="table d-none" id="expense_table_show">
                                <thead class="thead-light">
                                    <tr>
                                        <th scope="col">Nombre</th>
                                        <th scope="col">Fecha</th>
                                        <th scope="col">Monto</th>
                                        <th scope="col">Descripcion</th>
                                        <th scope="col">Operaciones</th>
                                    </tr>
                                </thead>
                                <tbody id="expense_table_id">

                                </tbody>
                            </table>
                        </div>
                    </div>
                </form>

            </t>

        </template>

        <template id="answer_form" name="Answer Form">
            <t t-call="portal.portal_layout">
                <div class="text-center">
                    <h2>Solicitud procesada satisfactoriamente</h2>
                    <img src="/hr_hn_portal_expense/static/src/img/gasto.webp" alt="Imagen Satisfactoria" width="50%"
                         height="50%"/>
                </div>
            </t>
        </template>

        <template id="model_record_card" name="Record Card">
            <t t-call="portal.portal_layout">
                <div class="container">
                    <div class="card shadow">
                        <div class="card-header bg-primary text-white">
                            <h3 class="card-title">Detalle del Registro</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <strong>Nombre:</strong>
                                        </label>
                                        <p class="form-control-plaintext">
                                            <t t-esc="record.name"/>
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <strong>Fecha:</strong>
                                        </label>
                                        <p class="form-control-plaintext">
                                            <t t-esc="record.date"/>
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <strong>Categoría:</strong>
                                        </label>
                                        <p class="form-control-plaintext">
                                            <t t-esc="record.product_id.display_name"/>
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <strong>Monto Total:</strong>
                                        </label>
                                        <p class="form-control-plaintext">
                                            <t t-esc="record.total_amount_currency"/>
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <strong>Modo de Pago:</strong>
                                        </label>
                                        <p class="form-control-plaintext">
                                            <t t-esc="payment_mode"/>
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <strong>Estado:</strong>
                                        </label>
                                        <p class="form-control-plaintext">
                                            <t t-esc="record.state"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <label class="form-label">
                                        <strong>Descripción:</strong>
                                    </label>
                                    <textarea class="form-control" readonly="1">
                                        <t t-esc="record.description"/>
                                    </textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
