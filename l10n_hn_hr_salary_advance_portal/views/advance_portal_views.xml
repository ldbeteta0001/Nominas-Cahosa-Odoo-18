<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<odoo>
    <data>
        <template id="advance_form_template" name="Adelanto de salario">
            <t t-call="portal.portal_layout">
                <div class="container mt-5 advance_request_form_js_class">
                    <form action="/#" method="post" string="Adelanto de salario"
                          class="o_mark_required needs-validation" data-mark="*" data-pre-fill="true"
                          data-model_name="salary.advance">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="form-group row  mt-2 text-center">
                            <h2>Adelanto de salario</h2>
                        </div>
                        <div class="form-group row mt-2">
                            <label for="employee_id" class="col-sm-2 col-form-label">Nombre del Empleado:</label>
                            <div class="col-sm-10">
                                <input type="hidden" name="employee_id" id="employee_id" t-att-value="employee_id.id"/>
                                <input type="text" class="form-control" id="employee_id_name" name="employee_id_name"
                                       t-att-value="employee_id.name" readonly="readonly"/>
                                <p class="d-none" id="input_employee_id"/>
                            </div>
                        </div>
                        <div class="form-group row mt-2">
                            <label for="date" class="col-sm-2 col-form-label">Fecha:</label>
                            <div class="col-sm-10">
                                <input type="date" class="form-control" id="date" name="date"
                                       t-att-value="date.strftime('%Y-%m-%d')"/>
                                <p class="d-none" id="input_date"/>
                            </div>
                        </div>
                        <div class="form-group row mt-2">
                            <label for="advance" class="col-sm-2 col-form-label">Importe:
                            </label>
                            <div class="col-sm-10">
                                <input type="number" class="form-control" id="advance" name="advance"
                                       t-att-value="advance" />
                                <p class="d-none" id="input_advance"/>
                            </div>
                        </div>
                        <div class="form-group row  mt-2">
                            <label for="reason" class="col-sm-2 col-form-label">Razón:</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" id="reason"
                                       name="reason"/>
                                <p class="d-none" id="input_reason"/>
                            </div>
                        </div>
                        <div class="form-group row mt-2">
                            <div class="col-sm-10">
                                <button type="submit" id="add_advance" t-on-click="addAdvance"
                                        class="btn btn-primary">Agregar adelanto
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </t>
        </template>

        <template id="answer_form" name="Answer Form">
            <t t-call="portal.portal_layout">
                <div class="text-center">
                    <h2>Solicitud procesada satisfactoriamente</h2>
                    <img src="/l10n_hn_hr_salary_advance_portal/static/src/img/advance.png" alt="Imagen Satisfactoria" width="50%"
                         height="50%"/>
                </div>
            </t>
        </template>
    </data>
</odoo>